{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Alias para importações absolutas ex: import { MyComponent } from '@/components/MyComponent'
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    // compatibilidade com modulos esm modernos 
    "moduleResolution": "bundler",
    "allowArbitraryExtensions": true,
    // habilita suporte a jsx para React (necessario para keystatic)
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [".astro/types.d.ts", "**/*", "src/**/*.ts", "src/**/*.tsx", "astro.config.mjs", "keystatic.config.ts"],
  "exclude": ["node_modules","dist"]
}
