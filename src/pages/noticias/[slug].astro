---
// Página de exibição de uma notícia individual da Revista Codorninha.
import Base from '@/layouts/Base.astro';
import { ownerData } from '@/data/owner_data';
import { listarNoticias, obterNoticia, gerarResumo } from '@/lib/noticias';
import Markdoc from '@markdoc/markdoc';
import TextResizer from '@/components/TextResizer.astro';

// Pré-renderizado no build: em produção, a função serverless não encontra src/content no disco.
export const prerender = true;

export async function getStaticPaths() {
  const noticias = await listarNoticias();
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const base = import.meta.env.BASE_URL;
const { slug } = Astro.params;
const { noticia: noticiaProp } = Astro.props;

const noticia = noticiaProp ?? (slug ? await obterNoticia(slug) : null);

if (!noticia) {
  Astro.response.status = 404;
}

const formatarDataCompleta = (dataIso: string): string => {
  const [ano, mes, dia] = dataIso.split('-').map(Number);
  if (!ano || !mes || !dia) return dataIso;
  const dataObj = new Date(Date.UTC(ano, mes - 1, dia));
  return new Intl.DateTimeFormat('pt-BR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(dataObj);
};

let conteudoHtml = '';
let metaDescricao = '';

if (noticia) {
  const markdocResultado = await noticia.conteudo();
  if (markdocResultado?.node) {
    const transformed = Markdoc.transform(markdocResultado.node);
    conteudoHtml = Markdoc.renderers.html(transformed);
  }
  metaDescricao = noticia.resumo || (await gerarResumo(noticia));
}

const imagemUrl = noticia?.imagem
  ? `${base}${noticia.imagem.replace(/^\//, '')}`
  : null;
---

<Base
  title={noticia ? noticia.titulo : 'Notícia não encontrada'}
  description={noticia ? metaDescricao : 'A página solicitada não foi encontrada ou foi removida.'}
  image={noticia? noticia.imagem ? `${base}${noticia.imagem.replace(/^\//, '')}` : ownerData.logo : ownerData.logo}
>
  {
    !noticia ? (
      // ... (Seu código de 404 permanece exatamente igual, está ótimo) ...
      <div class="mx-auto max-w-xl px-4 py-20 text-center sm:px-6">
        <span class="inline-block rounded-full bg-primary/10 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-primary">
          Erro 404
        </span>
        <h1 class="mt-4 font-heading text-3xl font-bold text-heading sm:text-4xl">
          Notícia não encontrada
        </h1>
        <p class="mt-3 text-base text-textMuted leading-relaxed">
          O conteúdo que você tentou acessar não existe, foi alterado ou não está mais disponível.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={`${base}noticias/`} class="inline-flex items-center rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white no-underline transition hover:opacity-90">
            &larr; Voltar para Notícias
          </a>
        </div>
      </div>
    ) : (
      <article class="mx-auto max-w-[70ch] px-4 py-10 sm:px-6 lg:py-16">
        
        {/* Link de retorno */}
        <nav aria-label="Navegação secundária" class="mb-10">
          <a
            href={`${base}noticias/`}
            class="group inline-flex items-center gap-2 text-sm font-semibold text-textMuted no-underline transition-colors hover:text-primary"
          >
            <span class="transition-transform group-hover:-translate-x-1" aria-hidden="true">&larr;</span>
            <span>Voltar para o arquivo</span>
          </a>
        </nav>

        {/* Cabeçalho da Notícia */}
        <header class="mb-10 border-b border-border pb-8">
          
          {/* DICA 4 APLICADA: Dataline estilo jornal literário */}
          <div class="flex flex-wrap items-center gap-3 mb-6">
            <time datetime={noticia.data} class="font-abstract text-xs font-bold uppercase tracking-[0.15em] text-secondary">
              {formatarDataCompleta(noticia.data)}
            </time>
            <span class="text-textMuted">&bull;</span>
            <span class="text-xs font-semibold uppercase tracking-[0.1em] text-textMuted">
              {ownerData.siteName}
            </span>

          </div>

          <h1 class="font-heading text-4xl font-bold leading-[1.15] text-heading sm:text-5xl lg:text-6xl">
            {noticia.titulo}
          </h1>

          {/* Resumo: Estilo "Excerto Datilografado" */}
          {noticia.resumo && (
            <p class="mt-8 border-l-[3px] border-primary bg-background pl-5 pr-3 py-4 font-abstract text-lg italic leading-[1.7] text-text sm:text-xl">
              {noticia.resumo}
            </p>
          )}
        </header>

        {/* Imagem de Capa */}
        {imagemUrl && (
          <figure class="my-10 overflow-hidden rounded-sm border border-border bg-surface shadow-sm">
            <img
              src={imagemUrl}
              alt=""
              class="h-auto w-full object-cover max-h-[480px] opacity-95 transition-opacity hover:opacity-100"
            />
          </figure>
        )}
        {/* Layout do Conteúdo e Redimensionador Responsivo */}
        <div class="article-layout-container mt-10">
          <aside class="resizer-aside">
            <TextResizer />
          </aside>

          <div class="conteudo-noticia article-content">
            <Fragment set:html={conteudoHtml} />
          </div>
        </div>

        {/* Rodapé do Artigo */}
        <footer class="mt-16 border-t border-border pt-8">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <a
              href={`${base}noticias/`}
              class="inline-flex items-center gap-2 text-sm font-semibold text-textMuted no-underline transition-colors hover:text-primary"
            >
              <span aria-hidden="true">&larr;</span>
              <span>Ler outras notícias</span>
            </a>
            <span class="text-xs font-abstract text-textMuted">
              Publicado por {ownerData.author.name}
            </span>
          </div>
        </footer>
      </article>
    )
  }
</Base>

<style>
  /* 
    DOMANDO O MARKDOC: 
    Estilos globais para garantir que o HTML injetado respeite a alma "Camus".
    Nota: Certifique-se de que as variáveis CSS (--color-*, --font-*) estejam 
    definidas no seu :root ou global.css, ou substitua pelos códigos hex.
  */

  /* Layout do artigo e posicionamento responsivo do TextResizer */
  .article-layout-container {
    position: relative;
    width: 100%;
  }

  /* Mobile first: no fluxo normal, logo antes do início do texto */
  .resizer-aside {
    width: 100%;
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: flex-start;
  }

  /* Desktop: sticky rail lateral fixo à esquerda do corpo do texto */
  @media (min-width: 1024px) {
    .article-layout-container {
      display: grid;
      grid-template-columns: 48px 1fr;
      column-gap: 2rem;
      margin-left: calc(-48px - 2rem);
      width: calc(100% + 48px + 2rem);
    }

    .resizer-aside {
      position: sticky;
      top: 6rem;
      height: fit-content;
      margin-bottom: 0;
      justify-content: center;
      align-self: flex-start;
      z-index: 30;
    }
  }

  .article-content {
    --font-scale: 1;
  }

  /* DICA 1 APLICADA: Respiração e Altura de Linha */
  .conteudo-noticia :global(p) {
    margin-bottom: 1.75rem; /* Espaço generoso entre parágrafos */
    line-height: 1.7; /* O ponto ideal: nem muito apertado, nem solto demais */
    color: var(--color-text, #2b2a28);
    font-size: calc(1.125rem * var(--font-scale, 1)); /* 18px para leitura confortável em telas */
  }

  .conteudo-noticia :global(h2) {
    font-family: var(--font-heading, 'Newsreader', serif);
    font-size: calc(1.75rem * var(--font-scale, 1));
    font-weight: 700;
    color: var(--color-heading, #14110f);
    margin-top: 3rem; /* Muito espaço acima para separar seções */
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .conteudo-noticia :global(h3) {
    font-family: var(--font-heading, 'Newsreader', serif);
    font-size: calc(1.4rem * var(--font-scale, 1));
    font-weight: 600;
    color: var(--color-heading, #14110f);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .conteudo-noticia :global(ul),
  .conteudo-noticia :global(ol) {
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
    color: var(--color-text, #2b2a28);
  }

  .conteudo-noticia :global(li) {
    font-size: calc(1rem * var(--font-scale, 1));
    margin-bottom: 0.6rem;
    line-height: 1.7;
  }

  /* Citações: O destaque "Camus" */
  /* Citação: O Híbrido "Clássico de Luxo" (Base 2 + Elementos 3) */
  .conteudo-noticia :global(blockquote) {
    /* O Fundo "Papel de Cigarro" da Opção 3 */
    background-color: var(--color-surface, #f7f4ee);
    
    /* A Bordas Sutil: Dourado fosco, fino e elegante (não agressivo como o vermelho) */
    border-left: 2px solid var(--color-secondary, #b8892b);
    border-radius: 0 4px 4px 0; /* Suaviza apenas os cantos da direita para parecer uma página */
    
    /* Espaçamento Generoso (A respiração da Opção 2) */
    margin: 3rem 0;
    padding: 1.75rem 2rem;
    
    /* Tipografia Literária */
    font-family: var(--font-body, 'Lora', serif);
    font-size: calc(1.2rem * var(--font-scale, 1)); /* Ligeiramente maior que o parágrafo normal para destaque */
    font-style: italic;
    line-height: 1.7;
    color: var(--color-heading, #14110f); /* Preto tabaco para máxima elegância e contraste */
    position: relative;
  }

  /* As linhas horizontais sutis da Opção 2 (O toque "Gallimard") */
  .conteudo-noticia :global(blockquote)::before,
  .conteudo-noticia :global(blockquote)::after {
    content: "";
    display: block;
    width: 48px;
    height: 1px;
    background-color: var(--color-secondary, #b8892b);
    opacity: 0.5; /* Sutil, como uma marca d'água ou detalhe de encadernação */
    margin: 0 auto;
  }

  .conteudo-noticia :global(blockquote)::before {
    margin-bottom: 1.25rem;
  }

  .conteudo-noticia :global(blockquote)::after {
    margin-top: 1.25rem;
  }

  /* Bônus: Se o seu Markdoc permitir um parágrafo dentro da citação para o autor (ex: <cite>) */
  .conteudo-noticia :global(blockquote cite) {
    display: block;
    margin-top: 1rem;
    font-size: 0.9rem;
    font-style: normal;
    font-family: var(--font-abstract, 'Courier Prime', monospace);
    color: var(--color-textMuted, #6f6a62);
    text-align: right;
  }
  
  .conteudo-noticia :global(blockquote cite)::before {
    content: "— ";
  }
  /* Links no texto: Sutis e elegantes */
  .conteudo-noticia :global(a) {
    color: var(--color-link, #8b1a1a);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .conteudo-noticia :global(a:hover) {
    color: var(--color-primary, #a4161a);
    text-decoration-color: var(--color-primary, #a4161a);
  }

  .conteudo-noticia :global(strong) {
    color: var(--color-heading, #14110f);
    font-weight: 600;
  }

  /* Código inline (caso o Markdoc renderize) */
  .conteudo-noticia :global(code) {
    font-family: var(--font-abstract, 'Courier Prime', monospace);
    font-size: 0.9em;
    background-color: var(--color-surface, #f7f4ee);
    color: var(--color-primary, #a4161a);
    padding: 0.2em 0.4em;
    border-radius: 3px;
    border: 1px solid var(--color-border, #cfc8bc);
  }
</style>