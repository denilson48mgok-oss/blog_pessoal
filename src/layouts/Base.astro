---
// Layout base de todas as páginas: <head> (título, descrição, favicon, fontes),
// variáveis de tema vindas de ownerData, Header, conteúdo da página e Footer.
import '../styles/global.css';
import { ownerData } from '../data/owner_data';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  /** Título específico da página; o nome da revista é acrescentado ao final. */
  title?: string;
  /** Meta description; se omitida, usa o slogan da revista. */
  description?: string;
  /** URL da imagem para redes sociais. */
  image?: string;
}

const { title, description, image } = Astro.props;

const base = import.meta.env.BASE_URL;
const tituloCompleto = title
  ? `${title} | ${ownerData.siteName}`
  : ownerData.tagline
    ? `${ownerData.siteName} | ${ownerData.tagline}`
    : ownerData.siteName;
const descricao = description ?? ownerData.tagline ?? ownerData.siteName;

// Caminhos de ownerData começam com "/"; removemos a barra para prefixar com BASE_URL (R9)
const faviconUrl = `${base}${ownerData.favicon.replace(/^\//, '')}`;
const faviconTipo = ownerData.favicon.endsWith('.svg') ? 'image/svg+xml' : undefined;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "http://localhost:4321");

// Cores e fontes do dono viram CSS variables no <html>, sobrescrevendo os padrões do global.css
const { colors, fonts } = ownerData;
const estiloTema = [
  `--color-primary: ${colors.primary}`,
  `--color-secondary: ${colors.secondary}`,
  `--color-background: ${colors.background}`,
  `--color-surface: ${colors.surface}`,
  `--color-text: ${colors.text}`,
  `--color-text-muted: ${colors.textMuted}`,
  `--color-heading: ${colors.heading}`,
  `--color-link: ${colors.link}`,
  `--color-border: ${colors.border}`,
  `--font-heading: ${fonts.heading}`,
  `--font-abstract: ${fonts.abstract}`,
  `--font-body: ${fonts.body}`,
].join('; ');
---

<!doctype html>
<html lang="pt-BR" style={estiloTema}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />

        <!-- SEO Primário -->
    <meta name="title" content={tituloCompleto} />
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Redes Sociais -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={image || ownerData.logo} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={tituloCompleto} />
    <meta property="twitter:description" content={descricao} />
    <meta property="twitter:image" content={image || ownerData.logo} />



    <link rel="icon" href={faviconUrl} type={faviconTipo} />
    {
      fonts.googleFontsUrl && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="stylesheet" href={fonts.googleFontsUrl} />
        </>
      )
    }
  </head>
  <body class="flex min-h-screen flex-col bg-background font-body text-text">
    <Header />
    <main id="conteudo" class="w-full flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
