---
// src/components/TextResizer.astro
// Controle de redimensionamento tipográfico com suporte responsivo a dock vertical sticky (desktop)
// e cápsula horizontal expansível (mobile), consumindo tokens de src/styles/global.css.
---

<div class="text-resizer-container" id="text-resizer">
  <!-- Botão Gatilho -->
  <button
    id="resizer-toggle-btn"
    class="pill-trigger"
    type="button"
    aria-expanded="false"
    aria-controls="resizer-slider-panel"
    aria-label="Ajustar tamanho da fonte"
  >
    <span class="aa-label">Aa</span>
    <span class="pill-divider" aria-hidden="true"></span>
  </button>

  <!-- Painel Deslizante -->
  <div id="resizer-slider-panel" class="slider-drawer closed" role="region" aria-label="Controle de escala de texto">
    <span class="size-hint small" aria-hidden="true">A-</span>
    <input
      type="range"
      id="font-range-input"
      min="85"
      max="140"
      step="5"
      value="100"
      aria-label="Tamanho da fonte em porcentagem"
    />
    <span class="size-hint large" aria-hidden="true">A+</span>
  </div>
</div>

<script>
  function initTextResizer() {
    const toggleBtn = document.getElementById('resizer-toggle-btn');
    const panel = document.getElementById('resizer-slider-panel');
    const slider = document.getElementById('font-range-input') as HTMLInputElement | null;
    const article = (document.querySelector('.article-content') || document.querySelector('.conteudo-noticia')) as HTMLElement | null;

    if (!toggleBtn || !panel || !slider || !article) return;

    // Restaurar preferência do usuário
    const savedScale = localStorage.getItem('blog:font-scale') || '100';
    slider.value = savedScale;
    article.style.setProperty('--font-scale', `${Number(savedScale) / 100}`);

    // Alternar abertura do slider
    toggleBtn.onclick = (e) => {
      e.stopPropagation();
      const isClosed = panel.classList.contains('closed');
      panel.classList.toggle('closed', !isClosed);
      toggleBtn.setAttribute('aria-expanded', String(isClosed));
    };

    panel.onclick = (e) => {
      e.stopPropagation();
    };

    // Atualização em tempo real
    slider.oninput = (e) => {
      const value = (e.target as HTMLInputElement).value;
      article.style.setProperty('--font-scale', `${Number(value) / 100}`);
      localStorage.setItem('blog:font-scale', value);
    };
  }

  // Fechar ao clicar fora ou ao pressionar Escape
  document.addEventListener('click', () => {
    const panel = document.getElementById('resizer-slider-panel');
    const toggleBtn = document.getElementById('resizer-toggle-btn');
    if (panel && !panel.classList.contains('closed')) {
      panel.classList.add('closed');
      toggleBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const panel = document.getElementById('resizer-slider-panel');
      const toggleBtn = document.getElementById('resizer-toggle-btn');
      if (panel && !panel.classList.contains('closed')) {
        panel.classList.add('closed');
        toggleBtn?.setAttribute('aria-expanded', 'false');
        toggleBtn?.focus();
      }
    }
  });

  initTextResizer();
  document.addEventListener('astro:page-load', initTextResizer);
</script>

<style>
  .text-resizer-container {
    position: relative;
    display: inline-flex;
    align-items: center;
    background: var(--color-surface, var(--bg-surface, #ffffff));
    box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.08);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: 9999px;
    padding: 0.25rem 0.5rem;
    transition: all 0.25s ease;
    user-select: none;
  }

  .pill-trigger {
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.5rem;
    color: var(--color-accent, var(--color-primary, #e8593c));
    font-weight: 700;
    font-size: 1.125rem;
    font-family: var(--font-heading, inherit);
    line-height: 1;
    outline: none;
    border-radius: 9999px;
    transition: opacity 0.2s ease;
  }

  .pill-trigger:hover .aa-label {
    opacity: 0.85;
  }

  .pill-trigger:focus-visible {
    outline: 2px solid var(--color-accent, var(--color-primary, #e8593c));
    outline-offset: 2px;
  }

  .pill-divider {
    background-color: var(--color-border, var(--border-color, #e2e8f0));
    transition: all 0.2s ease;
  }

  /* --- MOBILE: Formato Horizontal (Foto 2) --- */
  @media (max-width: 1023px) {
    .text-resizer-container {
      flex-direction: row;
      height: 40px;
    }

    .pill-trigger {
      flex-direction: row;
      gap: 0.5rem;
      height: 100%;
    }

    /* Linha divisória vertical (Foto 2) */
    .pill-divider {
      width: 1px;
      height: 18px;
    }

    .slider-drawer {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      overflow: hidden;
      max-width: 260px;
      opacity: 1;
      padding-left: 0.5rem;
      padding-right: 0.25rem;
      transition: max-width 0.3s ease, opacity 0.2s ease, padding 0.3s ease;
    }

    .slider-drawer.closed {
      max-width: 0;
      opacity: 0;
      padding-left: 0;
      padding-right: 0;
      pointer-events: none;
    }
  }

  /* --- DESKTOP: Formato Vertical Sticky (Foto 1) --- */
  @media (min-width: 1024px) {
    .text-resizer-container {
      flex-direction: column;
      width: 48px;
      padding: 0.6rem 0.25rem;
    }

    .pill-trigger {
      flex-direction: column;
      gap: 0.4rem;
      padding: 0.25rem 0;
      width: 100%;
    }

    /* Traço horizontal (Foto 1) */
    .pill-divider {
      width: 22px;
      height: 1px;
    }

    /* Painel do slider abre como flyout lateral */
    .slider-drawer {
      position: absolute;
      left: calc(100% + 0.75rem);
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--color-surface, var(--bg-surface, #ffffff));
      box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.12);
      border: 1px solid var(--color-border, #e2e8f0);
      border-radius: 9999px;
      padding: 0.5rem 0.85rem;
      white-space: nowrap;
      transition: opacity 0.2s ease, transform 0.2s ease;
      z-index: 50;
    }

    .slider-drawer.closed {
      opacity: 0;
      pointer-events: none;
      transform: translateY(-50%) translateX(-8px);
    }
  }

  /* Controles internos */
  .size-hint {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted, #64748b);
    user-select: none;
    line-height: 1;
  }

  .size-hint.large {
    font-size: 0.95rem;
  }

  input[type="range"] {
    accent-color: var(--color-accent, var(--color-primary, #e8593c));
    cursor: pointer;
    height: 4px;
    width: 100px;
  }

  input[type="range"]:focus-visible {
    outline: 2px solid var(--color-accent, var(--color-primary, #e8593c));
    outline-offset: 2px;
  }
</style>
