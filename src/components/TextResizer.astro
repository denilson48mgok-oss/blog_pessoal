---
// Controle de tamanho da fonte do artigo (botão "Aa" + slider).
// Aplica --font-scale em .conteudo-noticia e persiste o valor em localStorage.
---

<div class="text-resizer-wrapper">
  <button
    id="resizer-toggle"
    class="resizer-toggle-btn"
    type="button"
    aria-expanded="false"
    aria-controls="font-slider-container"
    aria-label="Ajustar tamanho da fonte"
  >
    Aa
  </button>

  <div
    id="font-slider-container"
    class="slider-panel"
    role="region"
    aria-label="Controle de tamanho de texto"
  >
    <span class="indicator-small" aria-hidden="true">A-</span>
    <input
      type="range"
      id="font-slider"
      min="80"
      max="140"
      step="5"
      value="100"
      aria-label="Escala do tamanho do texto em porcentagem"
    />
    <span class="indicator-large" aria-hidden="true">A+</span>
    <output id="font-slider-value" class="slider-value" for="font-slider">100%</output>
  </div>
</div>

<script>
  const STORAGE_KEY = 'blog:font-scale';

  function setupFontResizer() {
    const toggleBtn = document.getElementById('resizer-toggle');
    const panel = document.getElementById('font-slider-container');
    const slider = document.getElementById('font-slider') as HTMLInputElement | null;
    const valueLabel = document.getElementById('font-slider-value');
    const article = document.querySelector('.conteudo-noticia') as HTMLElement | null;

    if (!toggleBtn || !panel || !slider || !valueLabel || !article) return;

    const applyScale = (value: string) => {
      article.style.setProperty('--font-scale', String(Number(value) / 100));
      valueLabel.textContent = `${value}%`;
    };

    const savedScale = localStorage.getItem(STORAGE_KEY);
    const isValid =
      savedScale !== null &&
      Number(savedScale) >= Number(slider.min) &&
      Number(savedScale) <= Number(slider.max);
    slider.value = isValid ? savedScale : '100';
    applyScale(slider.value);

    toggleBtn.onclick = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      panel.classList.toggle('open', !isExpanded);
    };

    slider.oninput = () => {
      applyScale(slider.value);
      localStorage.setItem(STORAGE_KEY, slider.value);
    };
  }

  setupFontResizer();
  document.addEventListener('astro:page-load', setupFontResizer);
</script>

<style>
  .text-resizer-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    max-width: 100%;
  }

  .resizer-toggle-btn {
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.75rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .resizer-toggle-btn:hover,
  .resizer-toggle-btn[aria-expanded='true'] {
    color: var(--color-primary);
    background: var(--color-surface);
    border-color: var(--color-border);
  }

  .slider-panel {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 0 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }

  .slider-panel.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .indicator-small {
    font-size: 0.8rem;
  }

  .indicator-large {
    font-size: 1.2rem;
  }

  .slider-value {
    min-width: 3.5ch;
    font-family: var(--font-abstract);
    font-size: 0.8rem;
    text-align: right;
  }

  input[type='range'] {
    flex: 1 1 8rem;
    min-width: 0;
    width: 10rem;
    height: 44px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }

  input[type='range']::-webkit-slider-runnable-track {
    height: 4px;
    background: var(--color-border);
    border-radius: 9999px;
  }

  input[type='range']::-moz-range-track {
    height: 4px;
    background: var(--color-border);
    border-radius: 9999px;
  }

  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    margin-top: -8px;
    background: var(--color-primary);
    border: 2px solid var(--color-surface);
    border-radius: 9999px;
  }

  input[type='range']::-moz-range-thumb {
    width: 16px;
    height: 16px;
    background: var(--color-primary);
    border: 2px solid var(--color-surface);
    border-radius: 9999px;
  }

  input[type='range']:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>
